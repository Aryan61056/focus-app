<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only for a build signed with a developer identity and a provisioning profile (tools/build_app.sh with FOCUS_SIGN_IDENTITY).
     The local ad-hoc build must not carry these: macOS would refuse to launch it. __TEAM__, __BUNDLE__ and __CONTAINER__ are filled in by the script. -->
<plist version="1.0"><dict>
  <key>com.apple.application-identifier</key><string>__TEAM__.__BUNDLE__</string>
  <key>com.apple.developer.team-identifier</key><string>__TEAM__</string>
  <key>com.apple.developer.icloud-services</key><array><string>CloudKit</string></array>
  <key>com.apple.developer.icloud-container-identifiers</key><array><string>__CONTAINER__</string></array>
  <key>com.apple.developer.aps-environment</key><string>development</string>
</dict></plist>
